DEBUG=True
SECRET_KEY=change-me
# Supabase Postgres connection string (Project Settings > Database > Connection string).
# If omitted, a local SQLite file is used.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed in production behind HTTPS, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# SII mock (Pipedream)
SII_API_URL=https://eoej5sf0r8zkoh2.m.pipedream.net
# Public URL of this backend (ngrok / cloudflared tunnel or production). Empty = emission disabled.
PUBLIC_BASE_URL=
# Shared secret appended to the callbackUrl and checked by the webhook
SII_WEBHOOK_TOKEN=change-me

# Clerk
AUTH_ENABLED=False
CLERK_PUBLISHABLE_KEY=
