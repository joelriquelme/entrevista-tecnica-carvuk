# Copy to .env.local (gitignored) and fill in the values.

# Base URL of the Django REST API. Defaults to "/api", which the Vite dev server
# proxies to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_URL=/api

# Clerk publishable key (Clerk dashboard > API keys). Leave empty to run
# without authentication (dev mode).
VITE_CLERK_PUBLISHABLE_KEY=
